<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WindowsUtil.View.ColorPickerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WindowsUtil.View"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:WindowsUtil.Model"
    mc:Ignorable="d"
    Title="ColorPalette">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="GridRoot">
        <Border BorderBrush="Black" BorderThickness="1">
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.AvailableColors}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                    MinItemHeight="20" MinItemWidth="20" MinRowSpacing="0" MinColumnSpacing="0" MaximumRowsOrColumns="4">
                    </UniformGridLayout>
                </ItemsRepeater.Layout>

                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="model:ColorPaletteColor">
                        <Border Width="30" Height="20" Background="{Binding Brush}" BorderBrush="Black" BorderThickness="1" />
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </Border>
    </Grid>
</Window>
